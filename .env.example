# PostgreSQL (required by the application service)
DATABASE_URL=postgresql://robocactus:change-me@postgres:5432/robocactus
# Set true only when the PostgreSQL service requires TLS.
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# Application service
PORT=3000
APP_URL=http://localhost:3000
# Optional comma-separated additional browser origins, such as a www alias.
# ALLOWED_ORIGINS=https://www.example.com,https://preview.example.com
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_DAYS=30
UPLOAD_DIR=./data/uploads
UPLOAD_SIGNING_SECRET=replace-with-another-long-random-secret

# Public runtime choices (no credentials belong in VITE_* variables)
PAYMENT_PROVIDER=mock
# VITE_API_URL=  # leave blank when the browser and API use the same domain

# ZarinPal (server only)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# SMS (server only)
SMS_PROVIDER=ippanel
SMS_MOCK=true
SMS_PATTERNS={"auth_otp":"auth_otp"}
IPPANEL_API_KEY=
IPPANEL_ORIGINATOR=
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Email via Resend (server only)
EMAIL_MOCK=true
RESEND_API_KEY=
EMAIL_FROM=RoboCup Tabarestan <onboarding@resend.dev>

# Optional startup behavior
# APPLY_SEED=1
# NOTIFICATION_WORKER=true
