VITE_SUPABASE_URL=https://your-project.supabase.co
# Dashboard → Settings → API → anon / publishable (never service_role)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Auto migrations (npm run db:migrate / included in npm run dev)
# Recommended — HTTPS Management API (no IPv6 DB issues):
# Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Optional fallbacks:
SUPABASE_DB_PASSWORD=
# DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Payment
VITE_PAYMENT_PROVIDER=mock
VITE_ZARINPAL_MERCHANT_ID=
VITE_ZARINPAL_SANDBOX=true

# SMS providers (Edge Function secrets + optional Vite defaults)
VITE_SMS_PROVIDER=ippanel
VITE_SMS_MOCK=true
VITE_IPPANEL_API_KEY=
VITE_IPPANEL_ORIGINATOR=
VITE_KAVENEGAR_API_KEY=
VITE_KAVENEGAR_SENDER=
# Edge secrets (supabase secrets set): IPPANEL_*, KAVENEGAR_*, SMS_PROVIDER, SMS_MOCK, SMS_PATTERNS
