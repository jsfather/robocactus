{
  "name": "robocactous",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:soft && tsx watch server/index.ts",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:migrate:soft": "node scripts/apply-migrations.mjs --soft",
    "db:migrate:seed": "node scripts/apply-migrations.mjs --seed",
    "db:seed-demo-users": "node scripts/seed-demo-users.mjs",
    "db:rebuild-all-in-one": "node scripts/rebuild-all-in-one.mjs",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "lint": "oxlint",
    "test": "tsx tests/registration-lifecycle.test.ts",
    "preview": "NODE_ENV=production node dist-server/server/index.js",
    "start": "npm run db:migrate && NODE_ENV=production node dist-server/server/index.js"
  },
  "dependencies": {
    "arcaptcha-react": "^0.4.0",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.12",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "isomorphic-dompurify": "^3.18.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "react-multi-date-picker": "^4.5.2",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
